{
  "name": "layout-fixer",
  "description": "Fix text typed with the wrong keyboard layout — Arabic ⇄ English.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BugsBountyHunter/layout-fixer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "apps/extension"
  ],
  "scripts": {
    "dev": "npm run dev -w @layout-fixer/extension",
    "dev:firefox": "npm run dev:firefox -w @layout-fixer/extension",
    "build": "npm run build -w @layout-fixer/extension",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "npm run test:e2e -w @layout-fixer/extension",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck -w @layout-fixer/core -w @layout-fixer/ui && npm run test:coverage -w @layout-fixer/core -w @layout-fixer/ui && npm run check -w @layout-fixer/extension",
    "package:chrome": "npm run package:chrome -w @layout-fixer/extension",
    "package:firefox": "npm run package:firefox -w @layout-fixer/extension",
    "playground": "npm run playground -w @layout-fixer/extension",
    "store:screenshots": "npm run store:screenshots -w @layout-fixer/extension",
    "icons": "npm run icons -w @layout-fixer/extension"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
