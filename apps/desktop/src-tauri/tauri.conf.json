{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layout Fixer",
  "version": "1.0.0",
  "identifier": "io.github.bugsbountyhunter.layoutfixer",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Layout Fixer Settings",
        "width": 560,
        "height": 640,
        "minWidth": 440,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fix text typed with the wrong keyboard layout",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OTI4QzQzNzVBNDdFRTMKUldUamZxUjFRNHlTNVUyZHJ0RzVaTnhOejJIcDRhQVA3VkFBSnRiR0hKZEV5c3REUW9sL1BWbmIK",
      "endpoints": ["https://github.com/BugsBountyHunter/layout-fixer/releases/download/desktop-latest/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
